/*
* {
    color: black;
}
*/

QMainWindow {
    background-color: @white;
}

QWidget#HomeView, QWidget#MachineStatusView {
    background: transparent;
}

QMainWindow QWidget#kloeLogo QLabel {
    font-size: 60px;
    /* font-style: italic; */
}

QLabel#machineLogo {
    font-family: @artTtnorm;
    font-size: 44px;
    font-weight: 700;
    font-style: italic;
    color: @blue;
}

QLabel#machineLogoSubtrateSize {
    font-family: @artTtnorm;
    font-size: 28px;
    font-weight: 700;
    font-style: italic;
    color: @orange;
}

QFrame#bottomBar {
    background-color: @white;
    border: none;
    min-height: 86px; /** for resolution 1366x768 */
    max-height: 112px; /** for resolution 1920x1080 */
    /*border-bottom: 3px solid rgba(0, 112, 219, 160);*/
}

QLabel#kloeLogo {
    font-family: @artTtnorm;
    font-size: 56px;
    font-weight: 900;
    font-style: italic;
    color: @blue; 
}

QLabel {
    font-family: "Arial";
}

QFrame#navBtnIconCircle {
    background-color: rgb(0, 114, 186);
}
