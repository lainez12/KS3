/* 
Definitions colors 
@blue: #0072ba;
@blue-disabled: #D5E1ED;
@blue-kloe: #0070DB;
@blue-dark: #0E00DB;
@blue-light: #B2D4F4;
@orange: #e85420;
@orange-disabled: #FACBB9;
@lightGray: #f0f0f0;
@violet: #7D20E8;
@darkGray: #333333;
@white: #ffffff;
@turquoise: #00BCD1;
@primary-color: #3498db;


Font Families
@artTtnorm: ;

*/

/*
* {
    color: black;
}
*/

/* ==========================================================================
   Base / Global Widgets
   ========================================================================== */

QMainWindow {
    background-color: @white;
}

QLabel {
    font-family: "Arial";
}

QWidget#ExposureModeView,
QWidget#MachineStatusView {
    background: transparent;
}

QScrollBar::handle:vertical {
    background-color: @blue;
    min-height: 40px;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
    background-color: @white;;
}

/* ==========================================================================
   Layout Containers, Frames & Headers
   ========================================================================== */

QFrame#bottomBar {
    background-color: @white;
    border: none;
    min-height: 86px; /** for resolution 1366x768 */
    max-height: 112px; /** for resolution 1920x1080 */
    /*border-bottom: 3px solid rgba(0, 112, 219, 160);*/
}

QFrame#navBtnIconCircle {
    background-color: rgb(0, 114, 186);
}

QMainWindow QWidget#kloeLogo QLabel {
    font-size: 60px;
    /* font-style: italic; */
}

QLabel#kloeLogo {
    font-size: 56px;
    font-weight: 900;
    font-style: italic;
    color: @blue; 
}

QLabel#machineLogo {
    font-size: 44px;
    font-weight: 700;
    font-style: italic;
    color: @blue;
}

QLabel#machineLogoSubtrateSize {
    font-size: 28px;
    font-weight: 700;
    font-style: italic;
    color: @orange;
}

/* ==========================================================================
   Utility Classes - Typography
   ========================================================================== */

.text-extra-large {
    font-size: 42px;
    font-weight: 700;
}

.text-large {
    font-size: 32px;
    font-weight: 700;
}

.text-medium {
    font-size: 24px;
}

.text-small {
    font-size: 20px;
}

.text-extra-small {
    font-size: 16px;
}

.text-bold {
    font-weight: 700;
}

.positions-machine-status-text {
    font-size: 20px;
    font-weight: 700;
}

.text-last-cycle {
    background: transparent; 
    border-image: none;
    color: @orange;
    font-size: 20px;
    font-weight: 700;
}

/* ==========================================================================
   Utility Classes - Colors & Backgrounds
   ========================================================================== */

.color-blue {
    color: @blue;
}

.color-blue-light {
    color: @blue-light;
}

.color-orange {
    color: @orange;
}

.color-white {
    color: @white;
}

.bg-white {
    background-color: @white;
}

.bg-blue-kloe {
    background-color: @blue-kloe;
}

.bg-blue-dark {
    background-color: @blue-dark;
}

.bg-orange {
    background-color: @orange;
}

.bg-violet {
    background-color: @violet;
}

.bg-turquoise {
    background-color: @turquoise;
}

.none-background-image {
    background-image: "";
}

/* ==========================================================================
   Utility Classes - Borders & Outlines
   ========================================================================== */

.border-radius-25 {
    border-radius: 25px;
}

.border-solid-2 {
    border: 2px solid #000;
}

.border-solid-blue-small {
    border: 1px solid @blue;
}

.border-solid-blue {
    border: 2px solid @blue;
}

.border-solid-blue-medium {
    border: 4px solid @blue;
}

.border-solid-blue-large {
    border: 6px solid @blue;
}

.border-solid-blue-small:disabled {
    border: 1px solid @blue-light;
}

.border-solid-blue:disabled {
    border: 2px solid @blue-light;
}

.border-solid-blue-medium:disabled {
    border: 4px solid @blue-light;
}

.border-solid-blue-large:disabled {
    border: 6px solid @blue-light;
}

/* ==========================================================================
   Buttons & Controls
   ========================================================================== */

.button-blue,
.button-numpad {
    border: 2px solid @blue;
    background-color: @white;
    color: @blue;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

.button-fat {
    border: none;
}

.button-blue:checked {
    border: 2px solid @blue;
    background-color: @blue;
    color: @white;
}

.button-blue:disabled {
    border: 2px solid @blue-light;
    background-color: @white;
    color: @blue-light;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

.btn-blue, .btn-blue-lg {
    border: 2px solid @blue;
    border-radius: 15px;
    background-color: @blue;
    color: @white;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

.btn-blue-lg {
    border-width: 6px;
    font: 24px;
    font-weight: 700;
    border-radius: 25px;
}

.btn-blue:disabled, .btn-blue-lg:disabled {
    border-color: @blue-disabled;
    background-color: @blue-disabled;
}

.btn-orange, .btn-orange-lg {
    border: 2px solid @orange;
    border-radius: 25px;
    background-color: @orange;
    color: @white;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

.btn-orange-lg {
    border-width: 6px;
    font: 24px;
    font-weight: 700;
}

.btn-orange-lg:disabled {
    border-color: @orange-disabled;
    background-color: @orange-disabled;
}

.outline-btn-blue, .outline-btn-blue-lg {
    border: 2px solid @blue;
    border-radius: 15px;
    background-color: @white;
    color: @blue;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

.outline-btn-blue-lg {
    border-width: 6px;
    border-radius: 25px;
    font: 24px;
    font-weight: 700;
}

.outline-btn-blue:disabled, .outline-btn-blue-lg:disabled {
    border-color: @blue-disabled;
    color: @blue-disabled;
}

/* ==========================================================================
   Favorite Exposure Components
   ========================================================================== */

.title-favorite-exposure {
    font-weight: bold; 
    text-decoration: underline; 
    border: none;
}

.details-favorite-exposure {
    font-weight: bold; 
    border: none;
    qproperty-alignment: 'AlignJustify';
    qproperty-wordWrap: true;
}

.favorite-exposure-button {
    border: 1px solid #75B2E5;
    background-color: transparent;
}

.favorite-exposure-button:hover {
    background-color: #E6F0FA;
}

.favorite-exposure-button:pressed {
    background-color: #CCE4F7;
}

/* ===== Extracted from apps/software/gui/Views/*.ui ===== */


/* VersionView */
#VersionView QLabel#contactUs {
    font: normal normal bold 25px/25px Arial;
    letter-spacing: 0px;
    color: #E85420;
}
#VersionView QLabel#software,
#VersionView QLabel#version,
#VersionView QLabel#date {
    font: normal normal bold 40px/45px Arial;
    letter-spacing: 0px;
    color: #E85420;
}
#VersionView QLabel#siteWeb,
#VersionView QLabel#infos {
    font: normal normal bold 25px/25px Arial;
    letter-spacing: 0px;
    color: #0070DB;
}

/* UpdateSoftwareView */
#UpdateSoftwareView QLabel#date {
    font: normal normal bold 40px/45px Arial;
    letter-spacing: 0px;
    color: #E85420;
}

/* TemperatureView */
#TemperatureView QLabel#date {
    font: normal normal bold 40px/45px Arial;
    letter-spacing: 0px;
    color: #E85420;
}

/* ScreenshotExportView */
#ScreenshotExportView QScrollArea#scrollArea {
    background-color: transparent;
}

/* OperatingTimesView */
#OperatingTimesView QLabel#label_2,
#OperatingTimesView QLabel#date,
#OperatingTimesView QLabel#label_3 {
    font: normal normal bold 40px/45px Arial;
    letter-spacing: 0px;
    color: #E85420;
}
#OperatingTimesView QLabel#label,
#OperatingTimesView QLabel#label_3 {
    font: normal normal bold 40px/45px Arial;
    letter-spacing: 0px;
    color: #0070DB;
}

/* LedTestView */
#LedTestView QLabel#date {
    font: normal normal bold 40px/45px Arial;
    letter-spacing: 0px;
    color: #E85420;
}

/* HomeView (FormSplashScreen) */
#HomeView #FormSplashScreen {
    background-color: rgb(255, 255, 255);
}
#HomeView QLabel#mainSubmenuTitle,
#HomeView QLabel#waferLoaderSubmenuTitle,
#HomeView QLabel#maskLoaderSubmenuTitle,
#HomeView QWidget#widget_3,
#HomeView QWidget#widget_4 {
    border-left: none;
    border-right: none;
}

/* ExposureMenuView */
#ExposureMenuView QTextBrowser {
    border: 1px solid black;
}
#ExposureMenuView QScrollBar {
    width: 48px;
}
#ExposureMenuView QPushButton {
    padding: 0 20px;
}

/* ExposureSettingsView - numeric pad & common controls */
#ExposureSettingsView QPushButton.numpad,
#ExposureSettingsView QPushButton[name^="btn"] {
    border: 2px solid #0070DB;
    background-color: #ffffff;
    color: #0070DB;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

/* Save/Load dialogs - common button and lineedit */
#SaveExposureSettingsView QPushButton,
#SaveParametersView QPushButton,
#LoadParametersView QPushButton {
    border: 2px solid #0070DB;
    background-color: #ffffff;
    color: #0070DB;
    font: 20px;
    font-weight: 700;
    font-family: arial;
}

#SaveExposureSettingsView QScrollArea,
#SaveParametersView QScrollArea,
#LoadParametersView QScrollArea {
    background-color: #fff;
    border: 1px solid #0070DB;
}

/* ProgressExposureView */
#ProgressExposureView QLabel.orange {
    color: #E85420;
}
#ProgressExposureView QProgressBar {
    border: 1px solid #7D20E8;
    background-color: transparent;
}
#ProgressExposureView QProgressBar::chunk {
    background-color: #7D20E8;
}

/* VisualisationView */
#VisualisationView QCheckBox::indicator,
#LoadParametersView QCheckBox::indicator {
    width: 0px;
    height: 0px;
    border: none;
    background: none;
}
#VisualisationView QWidget#widget_8 {
    background-color: #0070DB;
    color: #fff;
    font-size: 20px;
}

/* ContactSelectionView placeholders (class-based in UI) */
#ContactSelectionView QPushButton[styleClass="clearradius"] {
    /* preserved as placeholder for clearradius buttons */
}

/* End of extracted rules */

.error-lineEdit {
    border: 2px solid @orange;
    text-align: left;
    font: normal normal bold 25px/29px Arial;
    letter-spacing: 0px;
    color: #E85420;
}

.lineEdit {
    border: 2px solid @blue-kloe;
    text-align: left;
    font: normal normal bold 25px/29px Arial;
    letter-spacing: 0px;
    color: #E85420;
}
