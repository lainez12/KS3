{
    "version": 3,
    "configurePresets": [
        {
            "name": "kub3-8-debug",
            "displayName": "KUB3-8 (Debug)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/kub8-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "KUB_MODEL": "8"
            }
        },
        {
            "name": "kub3-8-release",
            "displayName": "KUB3-8 (Release)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/kub8-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "KUB_MODEL": "8"
            }
        },
        {
            "name": "kub3-8-production",
            "displayName": "KUB3-8 (Production Deploy)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/kub8-production",
            "installDir": "${sourceDir}/dist/kub8-production",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PRODUCTION_BUILD": true,
                "KUB_MODEL": "8"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "kub3-8-debug",
            "configurePreset": "kub3-8-debug"
        },
        {
            "name": "kub3-8-release",
            "configurePreset": "kub3-8-release"
        },
        {
            "name": "kub3-8-production",
            "configurePreset": "kub3-8-production"
        }
    ]
}